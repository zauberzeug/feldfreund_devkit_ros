<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>devkit_launch</name>
  <version>0.1.0</version>
  <description>Launch files for the Feldfreund DevKit ROS2 package</description>
  <maintainer email="ros@zauberzeug.de">Zauberzeug GmbH</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>septentrio_gnss_driver</exec_depend>
  <exec_depend>devkit_driver</exec_depend>
  <exec_depend>devkit_ui</exec_depend>
  <exec_depend>devkit_description</exec_depend>
  <exec_depend>devkit_implement_automation</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>axis_camera</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
